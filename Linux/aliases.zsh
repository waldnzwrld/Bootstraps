alias zshconfig="$EDITOR ~/.zshrc"
alias zshreload=". ~/.zshrc"
alias vim=$(which nvim)
alias python="python3"
alias pip="pip3"
alias nnn="n -e"
alias ls="n -e"
alias go_headless="sudo systemctl disable lightdm.service && sudo reboot"
alias enable_ui="sudo systemctl start lightdm.service"
alias desktop="sudo systemctl enable lightdm.service && sudo reboot"
alias connect_to_wifi="/usr/local/bin/connect_to_wifi.sh"
