;; ~/.config/kanata/kanata.kbd
;;
;; Two features:
;;   1. Homerow mods (tap = letter, hold = modifier) in Miryoku GACS order,
;;      tuned after urob's "timeless" HRMs (requires kanata >= 1.12.0).
;;   2. Mac-style Cmd->Ctrl remapping that is active everywhere EXCEPT the
;;      terminal. Ctrl is NEVER remapped, so nvim's <C-...> maps are always safe.
;;
;; App-awareness is driven from OUTSIDE kanata: sway-app-watch.sh subscribes to
;; Sway focus events and sends ChangeLayer over TCP to flip term <-> gui.
;;
;; Validate before running:  kanata --cfg ~/.config/kanata/kanata.kbd --check

(defcfg
  process-unmapped-keys yes   ;; keys not listed in defsrc pass through normally
  ;; urob ingredient #4 (ZMK require-prior-idle-ms): a homerow key pressed
  ;; within this many ms of ANY other key is a plain letter, with no hold decision.
  ;; While you're typing at speed, the mods are effectively off.
  tap-hold-require-prior-idle 150   ;; (defcfg cannot read defvar)
)

(defvar
  tt   175   ;; tap-repress (ZMK quick-tap-ms): tap then hold = repeat the letter
  ht   280   ;; hold timeout (ZMK tapping-term-ms). Can be long because
             ;; opposite-hand resolution no longer depends on it.
)

;; urob ingredient #2 (hold-trigger-key-positions): a homerow key only becomes
;; a modifier when the NEXT key is on the opposite hand.
(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /))

(deftemplate hrm-l (tap hold)
  ;; urob ingredients #1 + #3: the -release variant = ZMK "balanced" flavor
  ;; (decide when the other key is released). Same-hand homerow keys are neutral
  ;; and ignored, which stands in for hold-trigger-on-release so that same-hand
  ;; mods stack (e.g. hold s+f, then tap t = Alt+Shift+t).
  (tap-hold-opposite-hand-release $ht $tap $hold
    (tap-repress-timeout $tt)
    (timeout hold)                  ;; held past $ht with no other key = modifier
    (same-hand tap)                 ;; same-hand roll = letters
    (neutral-keys a s d f)
    (neutral ignore)
    (unknown-hand hold))            ;; thumbs/ret/tab/arrows: mod+key works
)
(deftemplate hrm-r (tap hold)
  (tap-hold-opposite-hand-release $ht $tap $hold
    (tap-repress-timeout $tt)
    (timeout hold)
    (same-hand tap)
    (neutral-keys j k l ;)
    (neutral ignore)
    (unknown-hand hold))
)

;; -- Physical keys we care about. Everything else passes through untouched. --
(defsrc
  1    2    3    4    5    6    7    8    9    0
  w    r    t    o    p
  a    s    d    f    h    j    k    l    ;
  z    x    c    v    n
  ret  lmet rmet
)

(defalias
  ;; Homerow mods, left hand:  Ctrl Alt GUI(Super) Shift
  a_    (t! hrm-l a lctl)
  s_    (t! hrm-l s lalt)
  d_    (t! hrm-l d lmet)
  f_    (t! hrm-l f lsft)
  ;; Homerow mods, right hand: Shift GUI(Super) Alt Ctrl
  j_    (t! hrm-r j rsft)
  k_    (t! hrm-r k rmet)
  l_    (t! hrm-r l ralt)
  scln_ (t! hrm-r ; rctl)

  ;; In the GUI layer the Command key (and homerow-Super) don't emit Super at
  ;; all. They activate the cmd-held sublayer, which re-expresses each combo
  ;; as either Ctrl+key (app shortcut) or Super+key (sway WM).
  cmd    (layer-while-held cmd-held)
  a_g    (t! hrm-l a (layer-while-held cmd-held))
  scln_g (t! hrm-r ; (layer-while-held cmd-held))
)

;; ============================================================================
;; DEFAULT layer = first one. We default to `term` (native Super/Ctrl) because
;; that is the safe failure mode: if the focus watcher ever dies, Cmd stays
;; Super instead of silently turning into Ctrl inside a shell.
;; ============================================================================

(deflayer term
  1    2    3    4    5    6    7    8    9    0
  w    r    t    o    p
  @a_  @s_  @d_  @f_  h    @j_  @k_  @l_  @scln_
  z    x    c    v    n
  ret  lmet rmet
)

(deflayer gui
  1    2    3    4    5    6    7    8    9    0
  w    r    t    o    p
  @a_g @s_  @d_  @f_  h    @j_  @k_  @l_  @scln_g
  z    x    c    v    n
  ret  @cmd @cmd
)

;; Active only while Cmd is held (GUI apps). Letters -> Ctrl+<letter> (Mac
;; shortcuts); WM keys -> Super+<key> so sway still works. `_` = passthrough.
(deflayer cmd-held
  M-1  M-2  M-3  M-4  M-5  M-6  M-7  M-8  M-9  M-0
  C-w  C-r  C-t  C-o  C-p
  C-a  C-s  C-d  C-f  M-h  M-j  M-k  M-l  _
  C-z  C-x  C-c  C-v  C-n
  M-ret _    _
)
