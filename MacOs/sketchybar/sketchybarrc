##### Right #####
# Right items stack outward from the screen edge: last added is leftmost.

sketchybar --add item clock right \
           --set clock update_freq=10 icon= icon.color=$BLUE script="$PLUGIN_DIR/clock.sh" \
                 popup.align=right \
                 popup.background.color=$BAR_COLOR \
                 popup.background.border_color=$COMMENT \
                 popup.background.border_width=2 \
                 popup.background.corner_radius=10 \
                 popup.blur_radius=20 \
           --subscribe clock mouse.clicked mouse.exited.global \
           --add item battery right \
           --set battery icon.color=$GREEN update_freq=120 script="$PLUGIN_DIR/battery.sh" \
                 click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
           --subscribe battery system_woke power_source_change \
           --add item volume right \
           --set volume icon.color=$PURPLE script="$PLUGIN_DIR/volume.sh" \
                 popup.align=right \
                 popup.background.color=$BAR_COLOR \
                 popup.background.border_color=$COMMENT \
                 popup.background.border_width=2 \
                 popup.background.corner_radius=10 \
                 popup.blur_radius=20 \
           --subscribe volume volume_change mouse.clicked mouse.exited.global \
           --add slider volume.slider popup.volume 160 \
           --set volume.slider slider.highlight_color=$PURPLE \
                 slider.background.height=6 \
                 slider.background.corner_radius=3 \
                 slider.background.color=$BG_HIGHLIGHT \
                 slider.knob=󰝥 slider.knob.color=$FG \
                 padding_left=10 padding_right=10 \
                 script='osascript -e "set volume output volume $PERCENTAGE"' \
           --subscribe volume.slider mouse.clicked \
           --add item wifi right \
           --set wifi update_freq=30 script="$PLUGIN_DIR/wifi.sh" \
                 background.drawing=on background.color=$COMMENT \
                 background.corner_radius=6 background.height=24 \
                 icon.highlight=on icon.highlight_color=$BG icon.padding_left=8 \
                 label.highlight=on label.highlight_color=$BG label.padding_right=8 \
                 click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" \
           --subscribe wifi wifi_change system_woke \
           --add item caffeinate right \
           --set caffeinate label.drawing=off update_freq=60 script="$PLUGIN_DIR/caffeinate.sh" \
           --subscribe caffeinate system_woke mouse.clicked

##### AeroSpace workspaces (left, after the menu) #####
# Refreshed by AeroSpace's exec-on-workspace-change, which triggers
# aerospace_workspace_change with FOCUSED_WORKSPACE.

sketchybar --add event aerospace_workspace_change

for monitor in $(aerospace list-monitors --format '%{monitor-id}'); do
  for sid in $(aerospace list-workspaces --monitor "$monitor"); do
    space=(
      display="$monitor"
      icon="$sid"
      icon.color=$FG
      icon.highlight_color=$BLUE
      icon.padding_left=10
      label.color=$COMMENT
      label.highlight_color=$FG
      label.padding_right=12
      background.color=$BG_INACTIVE
      background.border_color=$COMMENT
      background.border_width=1
      background.corner_radius=6
      background.height=26
      script="$PLUGIN_DIR/aerospace.sh $sid"
      click_script="aerospace workspace $sid"
    )
    sketchybar --add item space."$sid" left \
               --set space."$sid" "${space[@]}" \
               --subscribe space."$sid" aerospace_workspace_change space_windows_change front_app_switched
  done
done

sketchybar --add item front_app left \
           --set front_app icon= icon.color=$PURPLE label.color=$CYAN script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --update
