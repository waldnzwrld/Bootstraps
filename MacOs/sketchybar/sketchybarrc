PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

sketchybar --bar position=top height=40 blur_radius=30 color=$BAR_COLOR

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Left: SketchyMenu #####
# Click opens the front app's menu bar as a popup; menus with submenus
# drill in on click. Needs Accessibility permission for sketchybar.

sketchybar --add item menu left \
           --set menu icon= icon.font="Hack Nerd Font:Bold:20.0" icon.color=$PURPLE \
                 label.drawing=off \
                 popup.height=30 \
                 popup.background.color=$BAR_COLOR \
                 popup.background.border_color=$COMMENT \
                 popup.background.border_width=2 \
                 popup.background.corner_radius=10 \
                 popup.blur_radius=20 \
                 click_script="$PLUGIN_DIR/sketchymenu/app_menu.sh"

